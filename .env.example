# Process configuration. Copy to .env in the working directory of the
# process (the data dir for an installed service: on macOS
# ~/Library/Application Support/eve-mcp/.env) or set as real env vars.
#
# The instance owns exactly one EVE application. Users never bring their own:
# they just open the MCP URL in Cursor / Claude and sign in with EVE in the
# browser. Each sign-in gets its own characters under DATA_DIR/users/{id}/.

# --- required ---------------------------------------------------------------
# From https://developers.eveonline.com/applications. Register the app with
# callback URL exactly: {PUBLIC_URL or http://127.0.0.1:8765}/auth/callback
CLIENT_ID=

# --- recommended ------------------------------------------------------------
# Identifies the operator to CCP in the User-Agent. An email address is
# strongly preferred; requests without a usable contact can get rate limited.
CONTACT=you@example.com

# --- optional ---------------------------------------------------------------
# Only if the EVE application was registered as confidential. PKCE is used
# either way; leaving it empty is the safer default.
# CLIENT_SECRET=

# Public HTTP surface (MCP + OAuth + pages).
# LISTEN=127.0.0.1:8765

# Internal surface (healthz, later metrics). Never route this publicly.
# INTERNAL_LISTEN=127.0.0.1:8766

# Public base URL when exposed through a tunnel / ingress. Also fixes the
# EVE callback to {PUBLIC_URL}/auth/callback.
# PUBLIC_URL=https://eve.example.com

# Where cache, users and the OAuth key live. Default: OS user config dir.
# DATA_DIR=

# Postgres DSN for the upcoming store cutover (T07). Unused by the binary
# until then. Matches `make postgres` (docker-compose.yml).
# DATABASE_URL=postgres://eve:eve@127.0.0.1:5432/eve_mcp?sslmode=disable

# Write policy.
#   off     - no mutating calls, write scopes are never even requested
#   confirm - preview + one-time token before anything happens  (default)
#   on      - execute immediately (still budgeted and audited)
# WRITE_MODE=confirm

# Permitted mutating capability groups. Comma separated, or "all"/"none".
#   waypoint openwindow fittings mail_organize calendar mail_send contacts
# WRITE_ALLOW=waypoint,openwindow,fittings,mail_organize

# Safety caps, per rolling hour.
# WRITE_BUDGET_PER_HOUR=40
# MAIL_BUDGET_PER_HOUR=5

# Seconds a confirm_token stays valid.
# CONFIRM_TTL=300

# Request corporation read scopes and register eve_corp_* tools.
# CORP_SCOPES=true

# ESI compatibility date. Moving it means re-checking response shapes.
# COMPAT_DATE=2026-08-18
