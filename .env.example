# Process configuration. Copy to .env in the working directory of the
# process, or set as real env vars.
#
# The instance owns exactly one EVE application. Users never bring their own:
# they just open the MCP URL in Cursor / Claude and sign in with EVE in the
# browser.

# --- required ---------------------------------------------------------------
# From https://developers.eveonline.com/applications. Register the app with
# callback URL exactly: {PUBLIC_URL or http://127.0.0.1:8765}/auth/callback
CLIENT_ID=

# Postgres DSN. Required at boot (ESI cache, users, OAuth, confirm tokens).
# Matches `make postgres` (docker-compose.yml).
DATABASE_URL=postgres://eve:eve@127.0.0.1:5432/eve_mcp?sslmode=disable

# MCP JWT signing key, min 32 bytes. Rotation = new secret + restart
# (every client re-authenticates; EVE grants are unaffected).
# HMAC_KEY=$(openssl rand -hex 32)
HMAC_KEY=

# --- recommended ------------------------------------------------------------
# Identifies the operator to CCP in the User-Agent. An email address is
# strongly preferred; requests without a usable contact can get rate limited.
CONTACT=you@example.com

# --- optional ---------------------------------------------------------------
# Only if the EVE application was registered as confidential. PKCE is used
# either way; leaving it empty is the safer default.
# CLIENT_SECRET=

# Public HTTP surface (MCP + OAuth + pages). Host and port together.
# LISTEN_HOST_PORT=127.0.0.1:8765

# Internal surface (healthz, readyz, later metrics). Never route publicly.
# INTERNAL_LISTEN_HOST_PORT=127.0.0.1:8766

# Public base URL when exposed through a tunnel / ingress. Required when
# LISTEN_HOST_PORT is not loopback; HTTPS unless the host is loopback.
# Also fixes the EVE callback to {PUBLIC_URL}/auth/callback.
# PUBLIC_URL=https://eve.example.com

# Extra exact OAuth redirect URIs (comma-separated), for an MCP client
# beyond Cursor / Claude. Absolute, no wildcard, no fragment.
# EXTRA_REDIRECT_URIS=https://app.example.com/oauth/callback
