# ---- required -------------------------------------------------------------
# From https://developers.eveonline.com/applications
# Register the app with callback URL exactly: http://localhost:8765/auth/callback
EVE_CLIENT_ID=

# Identifies you to CCP. An email address is strongly preferred; requests
# without a usable contact can get rate limited or banned.
EVE_CONTACT=you@example.com

# ---- optional -------------------------------------------------------------
# Only set this if your app was registered as a confidential client. PKCE is
# used either way; leaving it empty is the safer default.
# EVE_CLIENT_SECRET=

# Write policy.
#   off     - no mutating calls, write scopes are never even requested
#   confirm - preview + one-time token before anything happens  (default)
#   on      - execute immediately (still budgeted and audited)
EVE_WRITE_MODE=confirm

# Which groups of mutating actions are permitted. Comma separated, or "all"/"none".
#   waypoint      set autopilot waypoints
#   openwindow    open market/info/contract windows in the client
#   fittings      save and delete fittings
#   mail_organize mark read, delete mail
#   calendar      respond to event invitations
#   mail_send     send mail to other players      (off by default)
#   contacts      edit contacts and standings     (off by default)
EVE_WRITE_ALLOW=waypoint,openwindow,fittings,mail_organize

# Safety caps, per rolling hour.
EVE_WRITE_BUDGET_PER_HOUR=40
EVE_MAIL_BUDGET_PER_HOUR=5

# Seconds a confirm_token stays valid.
EVE_CONFIRM_TTL=300

# Also request corporation-level read scopes (needs the matching in-game roles).
EVE_CORP_SCOPES=false

# Shared secret for the /mcp endpoint. Required if you expose the port beyond
# localhost; unnecessary when bound to 127.0.0.1 as docker-compose.yml does.
# EVE_MCP_TOKEN=

# EVE_LOG_LEVEL=INFO
