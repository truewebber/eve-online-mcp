# Process configuration (SPEC §2). Copy to .env in the working directory,
# or set the same names as real env. The file wins if present. Nothing
# else is configurable — timeouts, session lifetime and ESI dates are
# constants in the packages that own them.

# --- required ---------------------------------------------------------------

# The instance EVE application (developers.eveonline.com). Register it
# with every scope in RequestedScopes() and callback
# {PUBLIC_URL or http://127.0.0.1:8765}/auth/callback.
CLIENT_ID=

# PostgreSQL DSN; the only durable store. No default. The value below
# matches `make postgres`.
DATABASE_URL=postgres://eve:eve@127.0.0.1:5432/eve_mcp?sslmode=disable

# MCP JWT signing key, min 32 bytes. Rotation = new secret + restart
# (every client re-authenticates). No default — generate one:
#   openssl rand -hex 32
HMAC_KEY=

# --- optional ---------------------------------------------------------------

# Only for a confidential EVE application. Empty by default. PKCE is
# used either way.
CLIENT_SECRET=

# Operator email in the User-Agent sent to CCP. Empty by default;
# strongly recommended.
CONTACT=

# Public bind: MCP, OAuth, human pages. Default 127.0.0.1:8765.
LISTEN_HOST_PORT=127.0.0.1:8765

# Internal bind: /healthz, /readyz, /metrics. Default 127.0.0.1:8766.
# Never route this listener publicly.
INTERNAL_LISTEN_HOST_PORT=127.0.0.1:8766

# Public base URL. Empty by default. Required when LISTEN_HOST_PORT is
# not loopback; https unless the host is loopback. Also fixes the EVE
# callback to {PUBLIC_URL}/auth/callback.
PUBLIC_URL=

# Comma-separated exact redirect URIs added to the built-in allowlist,
# for an MCP client this repo does not ship. Empty by default.
# Absolute, no wildcard, no fragment.
EXTRA_REDIRECT_URIS=
